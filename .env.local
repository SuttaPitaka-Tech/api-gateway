NODE_ENV=local
PORT=7001

# Gateway Configuration
# Service Discovery & Routing
FRONTEND_URL=http://localhost:7000
ROLE_ALLOCATION_SERVICE_URL=http://localhost:7002

# Nginx Gateway Settings
NGINX_GATEWAY_ENABLED=true
NGINX_LOAD_BALANCING=true
NGINX_SSL_TERMINATION=true

# API Configuration
API_PREFIX=api

# Health Check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:7000,http://localhost:7002
